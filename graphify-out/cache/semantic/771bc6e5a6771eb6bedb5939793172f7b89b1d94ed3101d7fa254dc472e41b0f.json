rl": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session mode (port 5432) of Supavisor is required because migrate and prepared statements fail on transaction mode (6543); 6543 is only for serverless high-scale and DISABLE_SERVER_SIDE_CURSORS is forced in base.py when ENGINE is postgres."}, {"id": "readme_media_url_links", "label": "Media as URLField links rationale", "file_type": "rationale", "source_file": "README.md", "source_location": 287, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no upload: product/service/portfolio/avatar images are external URLField links (validate_image_url) because the Vercel filesystem is ephemeral/read-only, so no bucket or django-storages is used and SERVE_MEDIA=False."}, {"id": "readme_test_sqlite", "label": "In-memory SQLite test settings rationale", "file_type": "rationale", "source_file": "README.md", "source_location": 255, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config.settings.test forces SQLite in memory so tests run offline and never touch the dev/prod database."}, {"id": "readme_uuid_pks", "label": "UUID PKs via BaseModel rationale", "file_type": "rationale", "source_file": "README.md", "source_location": 107, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All domain models inherit BaseModel (UUID pk, timestamps, is_active), so detail/edit URLs use <uuid:pk>; public shop/services listings use <slug:slug> with random auto-generated slugs via RandomSlugMixin."}], "edges": [{"source": "readme", "target": "workflows_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": 265, "weight": 1.0}, {"source": "readme", "target": "requirements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": 184, "weigh