# Django core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=America/Sao_Paulo

# Database (dev: sqlite / prod: mysql)
DATABASE_URL=sqlite:///db.sqlite3
# mysql://user:pass@host:3306/dbname

# django-allauth (Google / Facebook / Apple)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Pagamento (provedor abstrato; 'manual' nao cobra so marca transacao)
PAYMENT_PROVIDER=manual

# Asaas (integração real; PAYMENT_PROVIDER=asaas para ativar)
ASAAS_API_KEY=
ASAAS_SANDBOX=True
ASAAS_WEBHOOK_TOKEN=

# Gateway manual: token exigido no header x-webhook-token dos webhooks
MANUAL_WEBHOOK_TOKEN=

# Mercado Pago (opcional)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Email (prod)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=
