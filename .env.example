# Django core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=America/Sao_Paulo

# Database (SQLite no desenvolvimento; Supabase Postgres em produção via Vercel).
# Dev: DATABASE_URL=sqlite:///db.sqlite3
# Prod (Vercel): injete DATABASE_URL do Supabase (session mode, porta 5432) no dashboard.
DATABASE_URL=sqlite:///db.sqlite3

# django-allauth (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Site (django.contrib.sites + allauth) — domínio público de produção
DJANGO_SITE_DOMAIN=masterlightoficial.com
DJANGO_SITE_NAME=MasterLight

# Pagamento (provedor abstrato; default 'asaas' — Pix e cartão)
PAYMENT_PROVIDER=asaas

# Asaas (integração real; Pix e cartão)
# Chave lida CRUA (sem proxy '$' do django-environ), então cole direto: $aact_...
# A forma escapada legada (\\$aact_...) também é aceita pelo helper em
# config/settings/env_helpers.py.
ASAAS_API_KEY=
ASAAS_SANDBOX=True
ASAAS_WEBHOOK_TOKEN=

# Email (Brevo SMTP — 300 emails/dia grátis)
# Crie conta em brevo.com → Configurações → SMTP & API → Chaves SMTP
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=seu-usuario-smtp
DJANGO_EMAIL_HOST_PASSWORD=sua-chave-smtp
DJANGO_DEFAULT_FROM_EMAIL=MasterLight <no-reply@seudominio.com.br>
